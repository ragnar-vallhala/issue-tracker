# Copy to .env and adjust. Never commit the real file.
#
# The services read these from the environment; application.yml supplies development
# defaults so a clean checkout starts without any of them being set.

# MySQL login created by sql/setup.sql
DB_HOST=localhost
DB_PORT=3306
DB_USER=its
DB_PASSWORD='Its#Tracker2026!'

# JWT signing key. Must be at least 32 bytes for HS256, and must be IDENTICAL for
# user-service (which signs) and api-gateway (which verifies) - a mismatch shows up as
# every authenticated request returning 401 with a valid-looking token.
JWT_SECRET=its-dev-secret-key-change-me-min-32-bytes-long
JWT_EXPIRY_SECONDS=3600

# Bind address. 0.0.0.0 exposes each service on every interface; set 127.0.0.1 to
# make the system loopback-only.
SERVER_ADDRESS=0.0.0.0

# Infrastructure
EUREKA_URL=http://localhost:8761/eureka/
GATEWAY_URL=http://localhost:8080

# Load the reference workbook's sample rows into empty tables
SEED_ENABLED=true
